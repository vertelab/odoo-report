<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Search View -->
    <record id="fsm_order_search_view_inherit_map" model="ir.ui.view">
        <field name="name">fsm.order.search.inherit.map</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_search_view"/>
        <field name="arch" type="xml">
            <filter name="my_orders" position="after">
                <filter string="Service" name="type_service" domain="[('type.name', '=', 'Service')]"/>
                <filter string="Troubleshooting" name="type_troubleshooting" domain="[('type.name', '=', 'Troubleshooting')]"/>
                <filter string="New Installation" name="type_new_installation" domain="[('type.name', '=', 'New Installation')]"/>
                <filter string="Modernization" name="type_modernization" domain="[('type.name', '=', 'Modernization')]"/>
                <filter string="Upgrade" name="type_upgrade" domain="[('type.name', '=', 'Upgrade')]"/>
                <filter string="Repair" name="type_repair" domain="[('type.name', '=', 'Repair')]"/>
                <filter string="Inspection" name="type_inspection" domain="[('type.name', '=', 'Besiktning')]"/>
                <separator/>
            </filter>

            <xpath expr="//group[@expand='0']" position="inside">
                <filter string="Order Type" name="group_by_type" context="{'group_by': 'type'}"/>
            </xpath>
        </field>
    </record>

    <!-- Map View -->
    <record id="view_fsm_order_map" model="ir.ui.view">
        <field name="name">fsm.order.map</field>
        <field name="model">fsm.order</field>
        <field name="type">googlemap</field>
        <field name="arch" type="xml">
            <googlemap
                js_class="order_map"
                hide_partner_list="1"
                res_partner="location_id"
                default_latitude="57.7089"
                default_longitude="11.9746"
                panel_title="Arbetsordrar"
                limit="500">
                <field name="name"/>
                <field name="location_id"/>
                <field name="type"/>
                <field name="description"/>
                <field name="reporter"/>
                <field name="reporter_phone"/>
                <field name="person_id"/>
                <field name="stage_id"/>
                <field name="scheduled_date_start"/>
                <field name="scheduled_date_end"/>
            </googlemap>
        </field>
    </record>

    <!-- Add Map View Mode -->
    <record id="fieldservice.action_fsm_operation_order" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,calendar,pivot,googlemap</field>
    </record>

    <record id="fieldservice.action_fsm_dash_order" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form,googlemap</field>
    </record>

</odoo>
