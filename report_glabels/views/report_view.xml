<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="act_report_xml_view" model="ir.ui.view">
        <field name="name">ir.actions.report.xml.glabels</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view" />
        <field name="arch" type="xml">
            <field name="attachment" position="after">
                <field name="glabels_template" invisible="report_type not in ['qweb-glabels', 'glabels_rows']" />
                <field name="label_count" invisible="report_type not in ['qweb-glabels', 'glabels_rows']" />
                <field name="col_name" invisible="report_type not in ['qweb-glabels']" />
                <field name="col_value" invisible="report_type not in ['qweb-glabels']" />
                <field name="csv_fields" invisible="report_type not in ['qweb-glabels']" />
            </field>
        </field>
    </record>
</odoo>
