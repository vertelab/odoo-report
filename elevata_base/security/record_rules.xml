<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==========================================================
             Record Rules — Elevata Security
             ========================================================== -->

        <!-- Technician: sees only own work orders (assigned to them) -->
        <record id="rule_fsm_order_technician" model="ir.rule">
            <field name="name">Field Service Order: Technician sees own</field>
            <field name="model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
            <field name="domain_force">[('requested_employee_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('elevata_base.group_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager/Admin: sees all work orders (overrides technician rule) -->
        <record id="rule_fsm_order_manager" model="ir.rule">
            <field name="name">Field Service Order: Manager sees all</field>
            <field name="model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('elevata_base.group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Sales: reads all work orders but cannot write -->
        <record id="rule_fsm_order_sales" model="ir.rule">
            <field name="name">Field Service Order: Sales reads all</field>
            <field name="model_id" ref="fieldservice_vrtl.model_fieldservice_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('elevata_base.group_sales'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Elevators: technician read-only -->
        <record id="rule_fsm_location_technician" model="ir.rule">
            <field name="name">Equipment: Technician reads</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('elevata_base.group_technician'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Elevators: sales read/write -->
        <record id="rule_fsm_location_sales" model="ir.rule">
            <field name="name">Equipment: Sales reads/writes</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('elevata_base.group_sales'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
