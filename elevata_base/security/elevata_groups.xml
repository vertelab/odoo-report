<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             Elevata Security Groups — Hierarchy
             group_user → group_technician → group_manager → group_admin
                                           → group_sales → group_manager
             ============================================================ -->

        <!-- Module category for grouping in Settings → Users -->
        <record id="module_category_elevata" model="ir.module.category">
            <field name="name">Elevata</field>
            <field name="description">Elevata Hiss AB — permission groups</field>
            <field name="sequence">50</field>
        </record>

        <!-- Level 1: Base user (all employees) -->
        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="comment">Base — sees own work, limited access</field>
            <field name="category_id" ref="module_category_elevata"/>
        </record>

        <!-- Level 2a: Technician (inherits from group_user) -->
        <record id="group_technician" model="res.groups">
            <field name="name">Technician</field>
            <field name="comment">FSM orders, timesheets, checklists — NOT offers/contracts/pricelists</field>
            <field name="category_id" ref="module_category_elevata"/>
            <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        </record>

        <!-- Level 2b: Sales (inherits from group_user) -->
        <record id="group_sales" model="res.groups">
            <field name="name">Sales</field>
            <field name="comment">Offers, contracts, elevators — NOT accounting/configuration</field>
            <field name="category_id" ref="module_category_elevata"/>
            <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        </record>

        <!-- Level 3: Manager (inherits from technician + sales) -->
        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="comment">All functions + reports + pricelists</field>
            <field name="category_id" ref="module_category_elevata"/>
            <field name="implied_ids" eval="[(4, ref('group_technician')), (4, ref('group_sales'))]"/>
        </record>

        <!-- Level 4: Admin (inherits from manager) -->
        <record id="group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="comment">Full access — configuration, security, everything</field>
            <field name="category_id" ref="module_category_elevata"/>
            <field name="implied_ids" eval="[(4, ref('group_manager'))]"/>
        </record>

    </data>
</odoo>
