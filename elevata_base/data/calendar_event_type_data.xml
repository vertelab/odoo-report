<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             Calendar tags for color coding in the calendar view.
             Odoo 17 Community calendar.event.type has color_index (0-25)

             Color index guide (Odoo 17):
               0 = None/default   1 = Red       2 = Orange
               3 = Yellow         4 = Light blue 5 = Purple
               6 = Pink           7 = Cyan       8 = Dark blue
               9 = Magenta       10 = Green     11 = Dark green
             ============================================================ -->

        <!-- GREY (color=0) — Locked timesheet (order completed) -->
        <record id="calendar_tag_locked_timesheet" model="calendar.event.type">
            <field name="name">Locked Timesheet</field>
            <field name="color">0</field>
        </record>

        <!-- BLUE (color=8) — Open timesheet -->
        <record id="calendar_tag_open_timesheet" model="calendar.event.type">
            <field name="name">Timesheet</field>
            <field name="color">8</field>
        </record>

        <!-- YELLOW (color=3) — Planning, booked technician -->
        <record id="calendar_tag_planned_booked" model="calendar.event.type">
            <field name="name">Planning Booked</field>
            <field name="color">3</field>
        </record>

        <!-- ORANGE (color=2) — Planning, not booked -->
        <record id="calendar_tag_planned_unbooked" model="calendar.event.type">
            <field name="name">Planning Not Booked</field>
            <field name="color">2</field>
        </record>

    </data>
</odoo>
