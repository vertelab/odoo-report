<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ===== WORK SCHEDULES ===== -->

        <!-- Technician 07:00-16:00 Mon-Fri (1h lunch = 8h/day) -->
        <record id="calendar_technician" model="resource.calendar">
            <field name="name">Technician 07:00–16:00</field>
            <field name="hours_per_day">8.0</field>
            <field name="tz">Europe/Stockholm</field>
        </record>
        <record id="cal_tech_mon" model="resource.calendar.attendance">
            <field name="name">Monday</field>
            <field name="dayofweek">0</field>
            <field name="hour_from">7.0</field>
            <field name="hour_to">16.0</field>
            <field name="calendar_id" ref="calendar_technician"/>
        </record>
