<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Knappar på användarformuläret — rättighetsfliken -->
    <record id="view_users_form_access_profile" model="ir.ui.view">
        <field name="name">res.users.form.access.profile</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <div class="mt-3 mb-3">
                    <button name="action_load_access_profile"
                            string="Ladda rättighetsprofil"
                            type="object"
                            class="btn btn-primary me-2"
                            icon="fa-download"
                            groups="base.group_system"/>
                    <button name="action_save_access_profile"
                            string="Spara som profil"
                            type="object"
                            class="btn btn-outline-secondary"
                            icon="fa-save"
                            groups="base.group_system"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Profillista under Inställningar -->
    <record id="view_access_profile_list" model="ir.ui.view">
        <field name="name">elevata.access.profile.list</field>
        <field name="model">elevata.access.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_access_profile_form" model="ir.ui.view">
        <field name="name">elevata.access.profile.form</field>
        <field name="model">elevata.access.profile</field>
        <field name="arch" type="xml">
            <form string="Access Profile">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="note"/>
                    </group>
                    <separator string="Groups / Permissions"/>
                    <field name="group_ids" widget="many2many_tags"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_access_profile" model="ir.actions.act_window">
        <field name="name">Access Profiles</field>
        <field name="res_model">elevata.access.profile</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_access_profile"
              name="Access Profiles"
              parent="base.menu_users"
              action="action_access_profile"
              sequence="30"
              groups="base.group_system"/>

</odoo>
