<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_number" model="ir.ui.view">
        <field name="name">hr.employee.form.number</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_title']" position="after">
                <field name="employee_number" placeholder="e.g. 0001"/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_list_number" model="ir.ui.view">
        <field name="name">hr.employee.list.number</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_number" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
