<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_googlemap" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.googlemap</field>
        <field name="priority" eval="200"/>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Google Map" string="Google Map" name="elevata_googlemap" groups="base.group_system">
                    <h2>Google Map</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Set API keys</span>
                                <div class="text-muted">
                                    <span>
                                        Check the
                                        <a href="https://developers.google.com/maps/documentation/embed/get-api-key" target="_blank">page</a>
                                        for Create Google Map API keys
                                    </span>
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <label for="googlemap_api_key" string="API Key"/>
                                        <field name="googlemap_api_key"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
